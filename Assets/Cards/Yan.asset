    passiveDescription: "<b>Leader of Protectors</b>: Grants <b><color=#15c>+1</color></b>
      <b><color=#900>attack</color></b> to all allies who are <b><color=#555>Protectors</color></b>
      or <b><color=#555>Independent units</color></b>.\n<b>Anti-motion</b>: Grants
      <b><color=#15c>+1</color></b> <b><color=#760>defense</color></b> to all allies.\n\U0001F517
      <b>Crushing</b>: When I <b>attack \U0001F4A5</b> I get <b><color=#15c>+4</color></b>
      <b><color=#900>attack</color></b> <i>(for that attack)</i> if my <b><color=#583>HP</color></b>
      is less than or equal to <b>10</b>.\n\U0001F4AB <b>Protector's insignia</b>:
      When the enemies who are <b><color=#714>\U0001F3F4 mercenaries</color></b>
      <b>attack \U0001F4A5</b> they get <b><color=#15c>-2</color></b> <b><color=#900>attack</color></b>
      <i>(for that attack)</i> if I'm <b><color=#555>Protectors</color></b> or <b><color=#555>Independent
      units</color></b>.\n"
    passiveBuffDescriptions: "<b><color=#15c>+1</color></b> <b><color=#900>attack</color></b>
      from myself\n<b><color=#15c>+1</color></b> <b><color=#760>defense</color></b>
      from myself\n<b>\U0001F4A5 On hit</b>: <b><color=#15c>+4</color></b> <b><color=#900>attack</color></b>
      if my <b><color=#583>HP</color></b> is less than or equal to <b>10</b>, from
      myself\n<b>\U0001F4A5 On hit</b>: <b><color=#15c>-2</color></b> <b><color=#900>attack</color></b>
      if I'm <b><color=#555>Protectors</color></b> or <b><color=#555>Independent
      units</color></b>, from myself\n"
    actionsDescription: "\u2694\uFE0F Melee attack.\nGrants <b><color=#15c>+2</color></b>
      <b><color=#760>defense</color></b> to all allies.\n\u2694\uFE0F Melee or \u2728
      energy attack.\n"
