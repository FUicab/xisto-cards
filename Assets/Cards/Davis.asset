    passiveDescription: "\u2776 <b>Speed augment</b>: Your cards gain <b><color=#222>+1</color></b>
      <b><color=#222>free attack action</color></b> which also doesn't use its dice
      <i>(once per round)</i>.\n"
    passiveBuffDescriptions: 
    actionsDescription: "\u2694\uFE0F Melee attack and inflicts <b><color=#222>+3</color></b>
      <b><color=#c42>self-damage</color></b>.\nHeals <b><color=#15c>+8</color></b>
      <b><color=#583>HP</color></b> to me.\n\u2694\uFE0F Melee attack with <b><color=#15c>\xD72</color></b>
      <b><color=#900>damage</color></b> and inflicts <b><color=#222>+6</color></b>
      <b><color=#c42>self-damage</color></b>.\n"
