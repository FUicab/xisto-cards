    passiveDescription: "<b>Routine pursuit</b>: When I <b>attack \U0001F4A5</b>
      I get <b><color=#15c>+2</color></b> <b><color=#900>attack</color></b> <i>(for
      that attack)</i> when targetting <b><color=#714>\U0001F3F4 mercenaries</color></b>
      or <b><color=#555>Independent units</color></b>.\n"
    passiveBuffDescriptions: "<b>\U0001F4A5 On hit</b>: <b><color=#15c>+2</color></b>
      <b><color=#900>attack</color></b> when targetting <b><color=#714>\U0001F3F4
      mercenaries</color></b> or <b><color=#555>Independent units</color></b>, from
      myself\n"
    actionsDescription: "\U0001F3AF Ranged attack.\n\u2694\uFE0F Melee or \U0001F3AF
      ranged attack.\nGrants <b><color=#15c>-1</color></b> <b><color=#760>defense</color></b>
      to an enemy if they're <b><color=#714>\U0001F3F4 mercenaries</color></b> or
      <b><color=#555>Independent units</color></b>.\n"
