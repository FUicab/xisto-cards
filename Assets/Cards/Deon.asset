    passiveDescription: "\U0001F517 <b>Resilience</b>: I'm <b><color=#760>immune
      to extra attacks</color></b> <i>(including splash damage)</i>.\n<b>Heavy load</b>:
      Gives <b><color=#222>+1</color></b> <b><color=#781>action point cost</color></b>
      to me.\n"
    passiveBuffDescriptions: '<b><color=#222></color></b> <b><color=#900>attack</color></b>
      from myself

      <b><color=#222>+1</color></b> <b><color=#781>action point
      cost</color></b> from myself

'
    actionsDescription: "\u2694\uFE0F Melee attack and deals <b><color=#15c>+6</color></b>
      damage to enemies next to the target.\n\u2694\uFE0F Melee attack, with <b><color=#15c>+6</color></b>
      <b><color=#900>attack</color></b>.\n\u2694\uFE0F Melee attack and <b><color=#90f>Stuns</color></b>
      .\n<b><color=#222>2</color></b> \u2694\uFE0F Melee attacks and <b><color=#90f>Stuns</color></b>
      , with <b><color=#222>-8</color></b> <b><color=#900>attack</color></b>.\n"
