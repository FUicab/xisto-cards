    passiveDescription: 
    passiveBuffDescriptions: 
    actionsDescription: "\u2694\uFE0F Melee attack and <b><color=#583>heals </color></b>the
      most harmed ally <i>(prioritizing the front row)</i> for the amount of damage
      dealt.\nGrants <b><color=#15c>+2</color></b> <b><color=#900>attack</color></b>
      and <b><color=#15c>+4</color></b> <b><color=#b50>armor pierce</color></b> to
      an ally.\n\u2694\uFE0F Melee or \U0001F3AF ranged attack and <b><color=#583>heals
      </color></b>the most harmed ally <i>(prioritizing the front row)</i> for the
      amount of damage dealt.\n"
