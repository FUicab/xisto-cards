    passiveDescription: "<b>Conqueror</b>: When my allies who are <b><color=#555>Saggists</color></b>
      <b>attack \U0001F4A5</b> they get <b><color=#15c>+2</color></b> <b><color=#b50>armor
      pierce</color></b> <i>(for that attack)</i> when <b>not</b>  targetting <b><color=#555>Saggists</color></b>.\n"
    passiveBuffDescriptions: "<b>\U0001F4A5 On hit</b>: <b><color=#15c>+2</color></b>
      <b><color=#b50>armor pierce</color></b> when <b>not</b>  targetting <b><color=#555>Saggists</color></b>,
      from myself\n"
    actionsDescription: "\u2694\uFE0F Melee attack and removes <b><color=#15c>-2</color></b>
      <b><color=#760>defense</color></b> from the target.\n\U0001F3AF Ranged attack
      and removes <b><color=#15c>-2</color></b> <b><color=#760>defense</color></b>
      from the target.\n\u2694\uFE0F Melee or \U0001F3AF ranged attack which <b><color=#b50>ignores
      armor</color></b>.\n"
