    passiveDescription: "\U0001F517 <b>Honorable</b>: Grants <b><color=#15c>+1</color></b>
      <b><color=#760>defense</color></b> and <b><color=#15c>+1</color></b> <b><color=#900>attack</color></b>
      to me if I'm in the row in front of  the <b><color=#714>leader</color></b>.\n"
    passiveBuffDescriptions: '<b><color=#15c>+1</color></b> <b><color=#760>defense</color></b>
      from myself

      <b><color=#15c>+1</color></b> <b><color=#900>attack</color></b>
      from myself

'
    actionsDescription: "I take <b><color=#775>guarding pose</color></b>.\n\u2694\uFE0F
      Melee attack, with <b><color=#15c>\xD71</color></b> <b><color=#900>damage</color></b>
      if I have performed an action that affects  the <b><color=#714>leader</color></b>.\n\u2694\uFE0F
      Melee attack and heals <b><color=#15c>+2</color></b> <b><color=#583>HP</color></b>
      from me.\n"
